# =============================================================================
# AI Risk Evaluation Workbench — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values you need. API keys are read
# from the environment at runtime and are NEVER committed to source control.
#
# Mock mode is OPT-IN: set MOCK=1 only for offline/CI runs. Any other value
# (including unset) means real mode, where a missing base URL raises at startup
# instead of silently falling back to mock.
# =============================================================================

# -----------------------------------------------------------------------------
# Kilo gateway (frontier models)
# -----------------------------------------------------------------------------
# Frontier models (openai/gpt-5, anthropic/claude-opus-4.1, google/gemini-2.5-pro)
# are reached through the Kilo gateway. Find your key + gateway host in the Kilo
# dashboard (https://kilo.ai) under API keys / gateway settings.
KILO_API_KEY=your-kilo-key
KILO_BASE_URL=https://<kilo-gateway-host>/v1

# OpenAI fallback (used only if KILO_BASE_URL / KILO_API_KEY are unset).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# Modal L4 (open-source model)
# -----------------------------------------------------------------------------
# qwen3-8b is self-deployed on Modal.com with an NVIDIA L4 GPU (24 GB VRAM),
# served by vLLM as an OpenAI-compatible endpoint. Deploy it with:
#     modal deploy modal_deploy.py
# then copy the printed endpoint URL (append /v1) into OPEN_MODEL_BASE_URL.
# Modal endpoints usually don't require an API key, so "none" is fine.
OPEN_MODEL_API_KEY=none-or-modal-token
OPEN_MODEL_BASE_URL=https://your-workspace--qwen3-8b-inference.modal.run/v1

# -----------------------------------------------------------------------------
# Modal M4 / self-deployed Mistral Shieldstral
# -----------------------------------------------------------------------------
# Shieldstral (mistral-shieldstral) is self-deployed on Modal.com with vLLM.
# Deploy it with:
#     modal deploy modal_deploy_mistral.py
# then copy the printed endpoint URL (append /v1) into MISTRAL_MODEL_BASE_URL.
MISTRAL_MODEL_API_KEY=none-or-modal-token
MISTRAL_MODEL_BASE_URL=https://your-workspace--mistral-shieldstral-inference.modal.run/v1

# -----------------------------------------------------------------------------
# Mistral API (managed models)
# -----------------------------------------------------------------------------
# Mistral API models (mistral-small, mistral-large, etc.) are reached through
# Mistral's managed API. Get your key at https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# -----------------------------------------------------------------------------
# Real mode (mock is opt-in only)
# -----------------------------------------------------------------------------
# Set MOCK=1 to run the pipeline fully offline with deterministic, network-free
# backends (no API keys needed). Leave it 0 (or unset) for real evaluation runs.
MOCK=0

# -----------------------------------------------------------------------------
# Frontier / open-source provider selection (legacy assistant-comparison app)
# -----------------------------------------------------------------------------
FRONTIER_PROVIDER=kilo
FRONTIER_MODEL=deepseek/deepseek-v4-flash
KILOCODE_MODE=
OSS_BACKEND=local
OSS_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# Optional local-quality upgrade: Qwen/Qwen2.5-1.5B-Instruct
MODAL_OSS_ENDPOINT=
MODAL_OSS_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
MODAL_API_KEY=
MODAL_TIMEOUT_SECONDS=120
JUDGE_MODEL=deepseek/deepseek-v4-flash
APP_LOG_PATH=logs/chat_logs.jsonl
ENABLE_RETRIEVAL=false
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search
OSS_COST_PER_1K_REQUESTS_USD=0.00
FRONTIER_COST_PER_1K_REQUESTS_USD=0.17

# -----------------------------------------------------------------------------
# Cline gateway (free GLM-5.2 red-team target)
# -----------------------------------------------------------------------------
# cline-free/glm-5.2 is reached through Cline's free API gateway, which requires
# HTTP/2 and wraps responses in {"data": {...}, "success": true}. The token is a
# WorkOS OAuth JWT that expires — refresh it by running the `cline` CLI once.
# CLINE_API_KEY accepts either the full "workos:eyJ..." string or a bare token
# (the "workos:" prefix is prepended automatically if missing). If unset, the
# backend falls back to reading the token from
# ~/.cline/data/settings/providers.json (written by the Cline CLI).
CLINE_API_KEY=
CLINE_BASE_URL=https://api.cline.bot/api/v1
